# Configurações do Supabase/CrieFy Cloud
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-chave-publica"
# Compatibilidade com projetos que ainda utilizam a chave anon
VITE_SUPABASE_ANON_KEY="sua-chave-anon"

# Configurações do Asaas (Gateway de Pagamento Pix)
ASAAS_API_KEY="sua-chave-api-do-asaas"

# Token secreto de autenticação do webhook, configurado separadamente no painel do Asaas.
# Use um valor aleatório de 32 a 255 caracteres; não reutilize a chave de API do Asaas.
ASAAS_WEBHOOK_TOKEN="defina-um-token-secreto-aleatorio-com-pelo-menos-32-caracteres"

# URL da aplicação (usada para webhooks e redirecionamentos)
APP_URL="http://localhost:3000"
