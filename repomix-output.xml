  const [template, setTemplate] = useState<WhatsAppTemplate>("due");
  const [message, setMessage] = useState("");
  const selectedEntry = receivables.find((entry) => entry.id === selectedId);
  const filteredEntries = receivables.filter((entry) => {
    const term = search.trim().toLocaleLowerCase("pt-BR");
    return !term || `${entry.counterparty_name ?? ""} ${entry.description}`.toLocaleLowerCase("pt-BR").includes(term);
  });

  useEffect(() => {
    if (!open) return;
    const initialId = initialEntry && receivables.some((entry) => entry.id === initialEntry.id) ? initialEntry.id : "";
    setSelectedId(initialId);
    setTemplate("due");
    setMessage(initialId && initialEntry ? buildWhatsAppMessage(initialEntry, "due") : "");
    setSearch("");
  }, [open, initialEntry, receivables]);

  const selectEntry = (id: string) => {
    const entry = receivables.find((item) => item.id === id);
    setSelectedId(id);
    setMessage(entry ? buildWhatsAppMessage(entry, template) : "");
  };

  const selectTemplate = (value: WhatsAppTemplate) => {
    setTemplate(value);
    setMessage(selectedEntry ? buildWhatsAppMessage(selectedEntry, value) : "");
  };

  const send = () => {
    if (!selectedEntry) {
      toast.error("Selecione uma conta a receber.");
      return;
    }
    const url = createWhatsAppUrl(selectedEntry, message);
    if (!url) {
      toast.error("Confira o telefone do cliente e o conteúdo da mensagem.");
      return;
    }
    window.open(url, "_blank", "noopener,noreferrer");
    onOpenChange(false);
  };

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="max-h-[90vh] overflow-y-auto rounded-2xl sm:max-w-xl">
        <DialogHeader>
          <DialogTitle>Enviar cobrança pelo WhatsApp</DialogTitle>
          <DialogDescription>Escolha a conta do cliente, revise a mensagem e abra a conversa no WhatsApp.</DialogDescription>
        </DialogHeader>

        <div className="space-y-4">
          <div className="space-y-2">
            <label htmlFor="whatsapp-client-search" className="text-sm font-medium">Buscar cliente ou conta</label>
            <Input
              id="whatsapp-client-search"
              value={search}
              onChange={(event) => setSearch(event.target.value)}
              placeholder="Digite o nome do cliente ou a descrição"
              className="h-11 rounded-xl"
            />
            <div className="max-h-44 space-y-1 overflow-y-auto rounded-xl border p-1" role="listbox" aria-label="Contas a receber com WhatsApp">
              {filteredEntries.length ? filteredEntries.map((entry) => (
                <button
                  key={entry.id}
                  type="button"
                  role="option"
                  aria-selected={selectedId === entry.id}
                  onClick={() => selectEntry(entry.id)}
                  className={`w-full rounded-xl px-3.5 py-3 text-left text-sm transition-all duration-200 ${selectedId === entry.id ? "bg-accent text-accent-foreground ring-1 ring-primary/15" : "hover:bg-muted/75"}`}
                >
                  <span className="block font-medium">{entry.counterparty_name || "Cliente sem nome"}</span>
                  <span className="block text-xs text-muted-foreground">{entry.description} · {formatBRL(entry.amount_cents)} · vence {formatDate(entry.due_date)}</span>
                </button>
              )) : (
                <p className="px-3 py-4 text-center text-sm text-muted-foreground">
                  {receivables.length ? "Nenhum resultado para essa busca." : "Nenhuma conta a receber tem WhatsApp cadastrado."}
                </p>
              )}
            </div>
          </div>

          <div className="space-y-2">
            <label htmlFor="whatsapp-template" className="text-sm font-medium">Modelo da mensagem</label>
            <select
              id="whatsapp-template"
              value={template}
              onChange={(event) => selectTemplate(event.target.value as WhatsAppTemplate)}
              className="h-11 w-full rounded-xl border border-input/80 bg-background/75 px-3 text-sm shadow-sm outline-none transition focus:border-ring focus:ring-2 focus:ring-ring/20"
            >
              {TEMPLATES.map((option) => <option key={option.id} value={option.id}>{option.label}</option>)}
            </select>
          </div>

          {selectedEntry && (
            <div className="rounded-2xl border border-primary/10 bg-accent/35 p-4 text-sm">
              <p className="font-medium">{selectedEntry.counterparty_name || "Cliente sem nome"} · {selectedEntry.counterparty_whatsapp}</p>
              <p className="mt-1 text-muted-foreground">{selectedEntry.description} · {formatBRL(selectedEntry.amount_cents)} · vence {formatDate(selectedEntry.due_date)}</p>
              {template === "friendly" && !selectedEntry.pix_url && <p className="mt-1 text-xs text-warning">Esta conta não tem link de pagamento; o modelo indicará “não informado”.</p>}
            </div>
          )}

          <div className="space-y-2">
            <label htmlFor="whatsapp-message" className="text-sm font-medium">Mensagem editável</label>
            <Textarea
              id="whatsapp-message"
              value={message}
              onChange={(event) => setMessage(event.target.value)}
              placeholder="Selecione uma conta para gerar a mensagem."
              maxLength={4096}
              rows={7}
              disabled={!selectedEntry}
              className="rounded-xl"
            />
            <p className="text-right text-xs text-muted-foreground">{message.length}/4096</p>
          </div>
        </div>

        <DialogFooter>
          <Button variant="outline" className="h-11 rounded-xl" onClick={() => onOpenChange(false)}>Cancelar</Button>
          <Button className="h-11 rounded-xl bg-success px-5 text-success-foreground shadow-[0_10px_24px_-14px_var(--color-success)] hover:bg-success/90" disabled={!selectedEntry || !message.trim()} onClick={send}>
            <MessageCircle className="mr-2 h-4 w-4" />Enviar via WhatsApp
          </Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="src/lib/csv.ts">
export interface CsvRow {
  line: number;
  raw: Record<string, string>;
  errors: string[];
  value?: { type: "income" | "expense"; description: string; amount_cents: number; due_date: string; counterparty_name: string; counterparty_email: string; counterparty_whatsapp: string };
}

export const CSV_TEMPLATE =
  "descricao,valor,vencimento,tipo,nome,email,whatsapp\n" +
  'Consultoria março,"1.500,00",15/10/2026,entrada,Maria Silva,maria@exemplo.com,(11) 98765-4321\n' +
  "Aluguel escritório,1200,2026-10-10,saida,Imobiliária Centro,,\n";

function splitLine(line: string, sep: string) {
  const out: string[] = [];
  let cur = "", q = false;
  for (let i = 0; i < line.length; i++) {
    const c = line[i];
    if (c === '"') { if (q && line[i + 1] === '"') { cur += '"'; i++; } else q = !q; }
    else if (c === sep && !q) { out.push(cur); cur = ""; }
    else cur += c;
  }
  out.push(cur);
  return out.map((s) => s.trim());
}

export function parseMoney(s: string): number | null {
  let t = s.replace(/[R$\s]/g, "");
  if (!t) return null;
  if (t.includes(",")) t = t.replace(/\./g, "").replace(",", ".");
  const n = Number(t);
  return Number.isFinite(n) && n > 0 ? Math.round(n * 100) : null;
}

export function parseDate(s: string): string | null {
  let m = s.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
  let iso: string | null = null;
  if (m) iso = `${m[3]}-${m[2]}-${m[1]}`;
  m = s.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (m) iso = s;
  if (!iso) return null;
  const d = new Date(iso + "T12:00:00Z");
  return isNaN(d.getTime()) || d.toISOString().slice(0, 10) !== iso ? null : iso;
}

import { toE164 } from "./phone";
const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

export function parseCsv(text: string): { rows: CsvRow[]; headerError?: string } {
  const lines = text.replace(/^\uFEFF/, "").split(/\r?\n/).filter((l) => l.trim());
  if (!lines.length) return { rows: [], headerError: "Arquivo vazio." };
  const sep = lines[0].split(";").length > lines[0].split(",").length ? ";" : ",";
  const head = splitLine(lines[0], sep).map((h) => h.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, ""));
  const need = ["descricao", "valor", "vencimento", "tipo", "nome"];
  const missing = need.filter((n) => !head.includes(n));
  if (missing.length) return { rows: [], headerError: `Colunas ausentes: ${missing.join(", ")}.` };
  const rows = lines.slice(1).map((l, i) => {
    const cells = splitLine(l, sep);
    const raw = Object.fromEntries(head.map((h, j) => [h, cells[j] ?? ""]));
    const errors: string[] = [];
    const description = raw.descricao.slice(0, 200);
    if (!description) errors.push("Descrição vazia");
    const amount = parseMoney(raw.valor);
    if (amount === null) errors.push("Valor inválido");
    const date = parseDate(raw.vencimento);
    if (!date) errors.push("Data inválida");
    const tipo = raw.tipo.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    const type = tipo === "entrada" ? "income" : tipo === "saida" ? "expense" : null;
    if (!type) errors.push("Tipo deve ser entrada ou saida");
    const email = (raw.email ?? "").toLowerCase();
    const wa = toE164(raw.whatsapp ?? "");
    if (raw.whatsapp && !wa) errors.push("WhatsApp inválido");
    if (email && !EMAIL.test(email)) errors.push("E-mail inválido");
    const row: CsvRow = { line: i + 2, raw, errors };
    if (!errors.length && type && amount !== null && date) row.value = { type, description, amount_cents: amount, due_date: date, counterparty_name: raw.nome.slice(0, 120), counterparty_email: email, counterparty_whatsapp: wa ?? "" };
    return row;
  });
  return { rows };
}

export function parseStatementText(text: string): { rows: CsvRow[]; ignored: number } {
  const lines = text.split(/\r?\n/).map((line) => line.replace(/\s+/g, " ").trim()).filter(Boolean);
  const datePattern = /(?:^|\s)(\d{2}\/\d{2}\/\d{4}|\d{4}-\d{2}-\d{2})(?=\s|$)/;
  const amountPattern = /(?:R\$\s*)?([+-]?(?:\d{1,3}(?:\.\d{3})+|\d+)(?:,\d{2})?)\s*(CR|C|DB|D)?\s*$/i;
  const rows: CsvRow[] = [];
  let ignored = 0;

  for (const [index, line] of lines.entries()) {
    const dateMatch = line.match(datePattern);
    const amountMatch = line.match(amountPattern);
    if (!dateMatch || !amountMatch) {
      ignored++;
      continue;
    }

    const date = parseDate(dateMatch[1]);
    const cents = parseMoney(amountMatch[1].replace(/^[+-]/, ""));
    if (!date || cents === null) {
      ignored++;
      continue;
    }

    const transactionText = line
      .replace(dateMatch[0], " ")
      .replace(amountMatch[0], " ")
      .trim();
    const direction = amountMatch[2]?.toUpperCase();
    const negative = amountMatch[1].startsWith("-");
    const type = negative || direction === "D" || direction === "DB"
      ? "expense"
      : direction === "C" || direction === "CR" || amountMatch[1].startsWith("+") || /\b(receb|cr[eé]dito|dep[oó]sito|entrada)\w*/i.test(transactionText)
        ? "income"
        : /\b(pag|d[eé]bito|compra|sa[ií]da|tarifa|retirada)\w*/i.test(transactionText)
          ? "expense"
          : null;
    const errors = type ? [] : ["Não foi possível identificar se o lançamento é entrada ou saída."];
    const description = transactionText.slice(0, 200);
    if (!description) errors.push("Descrição não identificada no documento.");

    const row: CsvRow = {
      line: index + 1,
      raw: { descricao: description, valor: amountMatch[1], vencimento: dateMatch[1], tipo: type === "income" ? "entrada" : type === "expense" ? "saida" : "não identificado", nome: "" },
      errors,
    };
    if (!errors.length && type) {
      row.value = {
        type,
        description,
        amount_cents: cents,
        due_date: date,
        counterparty_name: "",
        counterparty_email: "",
        counterparty_whatsapp: "",
      };
    }
    rows.push(row);
  }
  return { rows, ignored };
}
