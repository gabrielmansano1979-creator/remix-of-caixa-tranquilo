ALTER TABLE public.reminder_rules ADD CONSTRAINT reminder_rule_channel_valid CHECK (channel IN ('email','whatsapp','both'));
ALTER TABLE public.reminder_logs ADD COLUMN channel text NOT NULL DEFAULT 'whatsapp';
