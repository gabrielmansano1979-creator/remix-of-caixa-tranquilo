import { createFileRoute, useNavigate } from "@tanstack/react-router";
import { useQuery, useQueryClient, useSuspenseQuery } from "@tanstack/react-query";
import { useServerFn } from "@tanstack/react-start";
import { useState } from "react";
import { z } from "zod";
import { toast } from "sonner";
import { CheckCircle2, AlertTriangle, FileUp, PencilLine, ArrowRight } from "lucide-react";
import { supabase } from "@/integrations/supabase/client";
import { profileQuery, entriesQuery, todaySP, addDays } from "@/lib/app-data";
import { saveFirstEntries } from "@/lib/onboarding.functions";
import { toE164 } from "@/lib/phone";
import { formatBRL, formatDate } from "@/lib/format";
import { Logo } from "@/components/brand";
import { MoneyInput } from "@/components/money-input";
import { CsvImportDialog } from "@/components/contas/csv-import";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Progress } from "@/components/ui/progress";
import { Skeleton } from "@/components/ui/skeleton";
import { Line, LineChart, ResponsiveContainer, XAxis, YAxis, Tooltip } from "recharts";

export const Route = createFileRoute("/_authenticated/onboarding")({
 head: () => ({ meta: [{ title: "Seus primeiros 90 segundos — Critical Cash" }, { name: "description", content: "Configure seu negócio e ative a previsão de caixa em três passos, sem cartão." }, { property: "og:title", content: "Primeiros passos — Critical Cash" }, { property: "og:description", content: "Seu caixa em três passos, com 7 dias grátis." }, { property: "og:type", content: "website" }, { name: "twitter:card", content: "summary" }, { name: "robots", content: "noindex" }] }),
 loader: ({ context }) => context.queryClient.ensureQueryData(profileQuery),
 pendingComponent: () => <Skeleton className="mx-auto mt-10 h-96 max-w-xl" />,
 errorComponent: () => <p role="alert" className="p-8 text-danger">Não foi possível carregar. Recarregue a página.</p>,
 component: Onboarding,
});
function Onboarding() {
 const { user } = Route.useRouteContext();
 const { data: profile } = useSuspenseQuery(profileQuery);
 const qc = useQueryClient(); const navigate = useNavigate(); const saveEntries = useServerFn(saveFirstEntries);
 const [step,setStep] = useState(profile?.business_name && profile?.notification_whatsapp ? 2 : 1);
 const [name,setName] = useState(profile?.full_name ?? user.user_metadata?.full_name ?? "");
 const [business,setBusiness] = useState(profile?.business_name ?? ""); const [phone,setPhone] = useState(profile?.notification_whatsapp ?? "");
 const [balance,setBalance] = useState(profile?.initial_balance_cents ?? 0);
 const blank = { description: "", amount_cents: 0, due_date: addDays(todaySP(),7), counterparty_name: "", counterparty_whatsapp: "" };
 const [expense,setExpense] = useState(blank); const [income,setIncome] = useState(blank);
 const [mode,setMode] = useState<'manual'|'csv'|null>(null); const [csv,setCsv] = useState(false); const [busy,setBusy] = useState(false); const [error,setError] = useState("");
 const entries = useQuery(entriesQuery);
 const projection = useQuery({ queryKey: ['projection'], enabled: step === 3, queryFn: async () => { const { data,error } = await supabase.rpc('cash_projection',{ _days: 30 }); if(error) throw error; return data as unknown as { status: 'green'|'yellow'|'red'; min_balance: number; min_date: string; series: {date:string;balance:number}[] }; } });
 const run = async (action: () => Promise<void>) => { setBusy(true); setError(''); try { await action(); } catch { setError('Não foi possível salvar. Confira os dados e tente novamente.'); } finally { setBusy(false); } };
 const saveProfile = () => run(async () => {
   const parsed = z.object({ full_name:z.string().trim().min(2).max(120), business_name:z.string().trim().min(2).max(120), notification_whatsapp:z.string().regex(/^\+[1-9][0-9]{9,14}$/) }).safeParse({ full_name:name,business_name:business,notification_whatsapp:toE164(phone) ?? '' });
   if(!parsed.success) { setError('Informe nome, negócio e WhatsApp com DDD válidos.'); return; }
   const { error } = await supabase.from('profiles').update(parsed.data).eq('user_id',user.id); if(error) throw error; await qc.invalidateQueries({queryKey:['profile']}); setStep(2);
 });
 const next = () => run(async () => {
   if(mode === 'csv') { if(!entries.data?.length) { setError('Importe pelo menos uma conta antes de continuar.'); return; } const {error} = await supabase.from('profiles').update({ initial_balance_cents: balance }).eq('user_id',user.id); if(error) throw error; }
   else { if(!expense.description.trim() || !income.description.trim() || expense.amount_cents <= 0 || income.amount_cents <= 0) { setError('Informe descrição, valor e vencimento das duas contas.'); return; } const r = await saveEntries({data:{balance,expense,income:{...income,counterparty_whatsapp:toE164(income.counterparty_whatsapp) ?? ''}}}); if(!r.ok) { setError(r.message); return; } }
   await qc.invalidateQueries({queryKey:['entries']}); await qc.invalidateQueries({queryKey:['projection']}); setStep(3);
 });
 const finish = () => run(async () => { const {error} = await supabase.from('profiles').update({onboarding_done:true}).eq('user_id',user.id); if(error) throw error; await qc.invalidateQueries({queryKey:['profile']}); toast.success('Seu caixa está pronto.'); const referralCode = user.user_metadata?.affiliate_referral_code; if (typeof referralCode === 'string' && referralCode) await navigate({to:'/planos', search:{ref:referralCode}}); else await navigate({to:'/caixa'}); });
 return <main className="min-h-screen bg-background px-5 py-8"><div className="mx-auto max-w-2xl"><Logo /><div className="mt-8 flex items-center justify-between text-sm"><span>Passo {step} de 3</span><span className="text-muted-foreground">7 dias grátis · Sem cartão</span></div><Progress className="mt-3 h-2" value={step/3*100} /><div className="mt-8 space-y-6">
 {step===1 ? <><h1 className="text-3xl font-semibold">Conte sobre seu negócio.</h1>{[["Seu nome",name,setName],["Nome do negócio",business,setBusiness],["WhatsApp do negócio",phone,setPhone]].map(([label,value,set],i) => <div key={String(label)}><Label htmlFor={'profile-'+i}>{String(label)}</Label><Input id={'profile-'+i} type={i===2?'tel':'text'} value={String(value)} maxLength={i===2?25:120} onChange={e => (set as (v:string)=>void)(e.target.value)} className="mt-2 min-h-11" /></div>)}<Button disabled={busy} className="min-h-12 w-full" onClick={saveProfile}>Continuar<ArrowRight className="ml-2 h-4 w-4" /></Button></> : step===2 ? <><h1 className="text-3xl font-semibold">Traga seus primeiros números.</h1><div><Label htmlFor="balance">Saldo atual</Label><MoneyInput id="balance" value={balance} onChange={setBalance} allowNegative /></div><div className="grid gap-3 sm:grid-cols-2"><Button variant={mode==='csv'?'default':'outline'} className="min-h-14 whitespace-normal" onClick={()=>{setMode('csv');setCsv(true);}}><FileUp className="mr-2 h-5 w-5 shrink-0" />Importar Planilha CSV</Button><Button variant={mode==='manual'?'default':'outline'} className="min-h-14 whitespace-normal" onClick={()=>setMode('manual')}><PencilLine className="mr-2 h-5 w-5 shrink-0" />Inserir 3 lançamentos manualmente</Button></div>
 {mode==='manual' && <div className="grid gap-6 sm:grid-cols-2">{([['Conta a pagar',expense,setExpense],['Conta a receber',income,setIncome]] as const).map(([title,value,set],i) => <section key={title} className="border-t pt-5"><h2 className="mb-5 font-semibold">{title}</h2><div className="space-y-4"><div><Label htmlFor={'desc-'+i}>Descrição</Label><Input id={'desc-'+i} value={value.description} maxLength={200} onChange={e=>set({...value,description:e.target.value})} className="mt-2 min-h-11" /></div><div><Label htmlFor={'value-'+i}>Valor</Label><MoneyInput id={'value-'+i} value={value.amount_cents} onChange={v=>set({...value,amount_cents:v})} /></div><div><Label htmlFor={'due-'+i}>Vencimento</Label><Input id={'due-'+i} type="date" value={value.due_date} onChange={e=>set({...value,due_date:e.target.value})} className="mt-2 min-h-11" /></div>{i===1 && <>{([['counterparty_name','Nome do cliente'],['counterparty_whatsapp','WhatsApp do cliente (opcional)']] as const).map(([key,label])=><div key={key}><Label htmlFor={key}>{label}</Label><Input id={key} value={value[key]} maxLength={key==='counterparty_whatsapp'?25:120} onChange={e=>set({...value,[key]:e.target.value})} className="mt-2 min-h-11" /></div>)}</>}</div></section>)}</div>}
 {mode==='csv' && <p className="text-sm text-muted-foreground">{entries.data?.length ?? 0} conta(s) cadastrada(s).</p>}<Button disabled={busy || !mode} onClick={next} className="min-h-12 w-full">Ver meu semáforo<ArrowRight className="ml-2 h-4 w-4" /></Button></> : <><h1 className="text-3xl font-semibold">Seu caixa já tem uma previsão.</h1>{projection.isLoading ? <Skeleton className="h-64" /> : projection.isError ? <Button variant="outline" onClick={()=>projection.refetch()}>Tentar calcular novamente</Button> : projection.data && <><section className={`cash-reveal flex gap-4 rounded-lg p-5 ${projection.data.status==='red'?'bg-danger/10 text-danger':projection.data.status==='yellow'?'bg-warning/10 text-warning':'bg-success/10 text-success'}`}>{projection.data.status==='green'?<CheckCircle2 className="h-8 w-8 shrink-0" />:<AlertTriangle className="h-8 w-8 shrink-0" />}<div><h2 className="text-xl font-semibold">{projection.data.status==='red'?'Risco: caixa negativo':projection.data.status==='yellow'?'Atenção: caixa apertado':'Tudo certo: o caixa fecha'}</h2><p className="mt-2">Menor saldo de {formatBRL(projection.data.min_balance)} em {formatDate(projection.data.min_date)}.</p></div></section><div className="h-60 w-full"><ResponsiveContainer width="100%" height="100%"><LineChart data={projection.data.series}><XAxis dataKey="date" tickFormatter={v=>formatDate(v).slice(0,5)} interval={6} /><YAxis hide /><Tooltip formatter={v=>formatBRL(Number(v))} labelFormatter={v=>formatDate(String(v))} /><Line dataKey="balance" stroke="var(--primary)" dot={false} strokeWidth={3} /></LineChart></ResponsiveContainer></div></>}
 <div className="border-y py-5"><p className="font-medium">Envio pelo WhatsApp</p><p className="mt-1 text-sm text-muted-foreground">As mensagens são preparadas para você revisar e enviar pelo WhatsApp Web ou aplicativo.</p></div><Button className="min-h-12 w-full" onClick={finish} disabled={busy || !projection.data}>Abrir meu caixa</Button></>}
 {error && <p role="alert" className="text-sm text-danger">{error}</p>}{step>1 && <Button variant="ghost" className="min-h-11" onClick={()=>setStep(step-1)} disabled={busy}>Voltar</Button>}
 </div><CsvImportDialog open={csv} onOpenChange={setCsv} onLimit={(_k,m)=>setError(m)} /></div></main>;
}
</file>

<file path="src/routes/contador.tsx">
import { createFileRoute, redirect } from "@tanstack/react-router";
import { useQuery, useQueryClient } from "@tanstack/react-query";
import { useEffect, useState } from "react";
import { Clipboard, Download, LoaderCircle, ShieldCheck } from "lucide-react";
import { toast } from "sonner";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { supabase } from "@/integrations/supabase/client";
import {
  exportReport,
  formatPixKeyType,
  getPartnerAffiliateLinks,
  type ReportFormat,
} from "@/lib/reporting";

export const Route = createFileRoute("/contador")({
  beforeLoad: async () => {
    const { data, error } = await supabase.auth.getUser();
    if (error || !data.user) throw redirect({ to: "/login" });
  },
  head: () => ({
    meta: [{ title: "Painel do contador — Critical Cash" }, { name: "robots", content: "noindex" }],
  }),
  component: AccountantPage,
});

type PartnerStatus = "none" | "pending_approval" | "approved" | "rejected";
type PartnerPageData = {
  status: PartnerStatus;
  full_name: string | null;
  tax_id: string | null;
  crc_number: string | null;
  pix_type: string | null;
  pix_key: string | null;
  coupon: { code: string; discount_percent: number; commission_percent: number } | null;
};
type PartnerDashboard = {
  totals: {
    commission_cents: number;
    pending_cents: number;
    paid_cents: number;
    referred_clients: number;
    active_clients: number;
  };
  commissions: Array<{
    id: string;
    client_name: string | null;
    amount_cents: number;
    status: string;
    created_at: string;
    paid_at: string | null;
  }>;
  clients: Array<{
    client_name: string | null;
    plan: string;
    status: string;
    entry_count: number;
    income_cents: number;
    expense_cents: number;
    shared_at: string;
    entries: Array<{
      description: string;
      type: "income" | "expense";
      amount_cents: number;
      due_date: string;
      status: string;
      paid_at: string | null;
    }>;
  }>;
};

const empty = { full_name: "", tax_id: "", crc_number: "", pix_type: "cpf", pix_key: "" };
const money = (cents: number) =>
  new Intl.NumberFormat("pt-BR", { style: "currency", currency: "BRL" }).format(cents / 100);

function AccountantPage() {
  const queryClient = useQueryClient();
  const [form, setForm] = useState(empty);
  const [busy, setBusy] = useState(false);
  const query = useQuery({
    queryKey: ["partner-area"],
    queryFn: async () => {
      const { data, error } = await supabase.rpc("my_partner_status");
      if (error) throw error;
      const status = data as PartnerPageData;
      const { data: dashboard, error: dashboardError } =
        status.status === "approved"
          ? await supabase.rpc("partner_dashboard")
          : { data: null, error: null };
      if (dashboardError) throw dashboardError;
      return { status, dashboard: dashboard as PartnerDashboard | null };
    },
  });
  const state = query.data?.status;
  const dashboard = query.data?.dashboard;
  useEffect(() => {
    if (state && state.status !== "none") {
      setForm({
        full_name: state.full_name ?? "",
        tax_id: state.tax_id ?? "",
        crc_number: state.crc_number ?? "",
        pix_type: state.pix_type ?? "cpf",
        pix_key: state.pix_key ?? "",
      });
    }
  }, [state]);

  const submit = async (event: React.FormEvent) => {
    event.preventDefault();
    const taxId = form.tax_id.replace(/\D/g, "");
    if (taxId.length !== 11 && taxId.length !== 14)
      return toast.error("Informe um CPF ou CNPJ válido.");
    if (!/^[A-Z]{2}-\d{6}\/[A-Z]$/.test(form.crc_number.toUpperCase()))
      return toast.error("Informe o CRC no formato UF-123456/O.");
    setBusy(true);
    try {
      const { error } = await supabase.rpc("submit_partner_request", {
        _full_name: form.full_name.trim(),
        _tax_id: taxId,
        _crc_number: form.crc_number.trim().toUpperCase(),
        _pix_type: form.pix_type,
        _pix_key: form.pix_key.trim(),
      });
      if (error) throw error;
      await queryClient.invalidateQueries({ queryKey: ["partner-area"] });
      toast.success("Solicitação enviada para análise.");
    } catch (error) {
      toast.error(
        error instanceof Error ? error.message : "Não foi possível enviar a solicitação.",
      );
    } finally {
      setBusy(false);
    }
  };

  const copy = async (value: string) => {
    try {
      await navigator.clipboard.writeText(value);
      toast.success("Link copiado.");
    } catch {
      toast.error("Não foi possível copiar o link.");
    }
  };

  if (query.isLoading) return <div className="p-8 text-muted-foreground">Carregando painel...</div>;
  if (query.isError)
    return (
      <div className="rounded-2xl border p-6 text-danger">
        Não foi possível carregar os dados do painel.{" "}
        <Button variant="outline" onClick={() => query.refetch()}>
          Tentar novamente
        </Button>
      </div>
    );

  if (state?.status !== "approved") {
    return (
      <div className="mx-auto max-w-3xl space-y-6 py-8">
        <div>
          <p className="text-xs font-semibold uppercase tracking-[0.18em] text-primary">
            Programa de parceiros
          </p>
          <h1 className="mt-2 text-3xl font-bold">Área do contador</h1>
        </div>
        {state?.status === "pending_approval" && (
          <div
            role="status"
            className="rounded-2xl border border-amber-400/20 bg-amber-400/5 p-5 text-sm text-amber-100"
          >
            Sua solicitação está em análise. Você poderá acessar os links de indicação após a
            aprovação.
          </div>
        )}
        {state?.status === "rejected" && (
          <div
            role="alert"
            className="rounded-2xl border border-danger/20 bg-danger/5 p-5 text-sm text-danger"
          >
            A solicitação anterior não foi aprovada. Revise os dados e envie novamente.
          </div>
        )}
        {state?.status !== "pending_approval" && (
          <Card>
            <CardHeader>
              <CardTitle>Solicitar parceria</CardTitle>
            </CardHeader>
            <CardContent>
              <form onSubmit={submit} className="grid gap-4 sm:grid-cols-2">
                <div>
                  <Label htmlFor="partner-name">Nome completo</Label>
                  <Input
                    id="partner-name"
                    required
                    minLength={2}
                    maxLength={160}
                    value={form.full_name}
                    onChange={(e) => setForm({ ...form, full_name: e.target.value })}
                  />
                </div>
                <div>
                  <Label htmlFor="partner-doc">CPF ou CNPJ</Label>
                  <Input
                    id="partner-doc"
                    required
                    value={form.tax_id}
                    onChange={(e) => setForm({ ...form, tax_id: e.target.value })}
                  />
                </div>
                <div>
                  <Label htmlFor="partner-crc">CRC</Label>
                  <Input
                    id="partner-crc"
                    required
                    placeholder="SP-123456/O"
                    value={form.crc_number}
                    onChange={(e) => setForm({ ...form, crc_number: e.target.value })}
                  />
                </div>
                <div>
                  <Label htmlFor="partner-pix-type">Tipo de chave PIX</Label>
                  <select
                    id="partner-pix-type"
                    className="mt-1.5 h-10 w-full rounded-xl border bg-background px-3 text-sm"
                    value={form.pix_type}
                    onChange={(e) => setForm({ ...form, pix_type: e.target.value })}
                  >
                    <option value="cpf">CPF</option>
                    <option value="cnpj">CNPJ</option>
                    <option value="email">E-mail</option>
                    <option value="phone">Telefone</option>
                    <option value="random">Aleatória</option>
                  </select>
                </div>
                <div className="sm:col-span-2">
                  <Label htmlFor="partner-pix-key">Chave PIX para recebimento</Label>
                  <Input
                    id="partner-pix-key"
                    required
                    maxLength={180}
                    value={form.pix_key}
                    onChange={(e) => setForm({ ...form, pix_key: e.target.value })}
                  />
                </div>
                <Button type="submit" disabled={busy} className="h-11 rounded-xl sm:col-span-2">
                  {busy && <LoaderCircle className="mr-2 h-4 w-4 animate-spin" />}Enviar para
                  análise
                </Button>
              </form>
            </CardContent>
          </Card>
        )}
      </div>
    );
  }

  const links = getPartnerAffiliateLinks(state.coupon?.code ?? "");
  const history = dashboard?.commissions ?? [];
  const clientRows = dashboard?.clients ?? [];
  const commissionRows = history.map((item) => ({
    cliente: item.client_name ?? "Cliente",
    valor: money(item.amount_cents),
    situacao: item.status,
    data: new Date(item.created_at).toLocaleDateString("pt-BR"),
    pago_em: item.paid_at ? new Date(item.paid_at).toLocaleDateString("pt-BR") : "—",
  }));
  const exportClients = async (format: ReportFormat) => {
    try {
      await exportReport({
        title: "Relatório de clientes que autorizaram compartilhamento",
        fileName: "clientes-compartilhados",
        format,
        columns: [
          { key: "cliente", label: "Cliente" },
          { key: "descricao", label: "Descrição" },
          { key: "tipo", label: "Tipo" },
          { key: "valor", label: "Valor" },
          { key: "vencimento", label: "Vencimento" },
          { key: "status", label: "Status" },
        ],
        rows: clientRows.flatMap((client) =>
          client.entries.map((entry) => ({
            cliente: client.client_name ?? "Cliente",
            descricao: entry.description,
            tipo: entry.type === "income" ? "Entrada" : "Saída",
            valor: money(entry.amount_cents),
            vencimento: new Date(`${entry.due_date}T12:00:00`).toLocaleDateString("pt-BR"),
            status: entry.status === "paid" ? "Pago" : "Pendente",
          })),
        ),
        summary: [
          ["Clientes autorizados", clientRows.length],
          [
            "Lançamentos incluídos",
            clientRows.reduce((count, client) => count + client.entry_count, 0),
          ],
        ],
      });
    } catch (error) {
      toast.error(error instanceof Error ? error.message : "Não foi possível gerar o relatório.");
    }
  };
  const exportCommissions = async (format: ReportFormat) => {
    try {
      await exportReport({
        title: "Extrato de comissões",
        fileName: "extrato-comissoes",
        format,
        columns: [
          { key: "cliente", label: "Cliente" },
          { key: "valor", label: "Valor" },
          { key: "situacao", label: "Situação" },
          { key: "data", label: "Data" },
          { key: "pago_em", label: "Pago em" },
        ],
        rows: commissionRows,
        summary: [["Total acumulado", money(dashboard?.totals.commission_cents ?? 0)]],
      });
    } catch (error) {
      toast.error(error instanceof Error ? error.message : "Não foi possível gerar o relatório.");
    }
  };

  return (
    <div className="mx-auto max-w-7xl space-y-6 py-8">
      <header>
        <p className="text-xs font-semibold uppercase tracking-[0.18em] text-primary">
          Parceiro contábil
        </p>
        <h1 className="mt-2 text-3xl font-bold">Painel do contador</h1>
        <p className="mt-2 text-sm text-muted-foreground">
          Acompanhe indicações, comissões e os clientes que autorizaram acesso aos seus relatórios.
        </p>
      </header>
      <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <Metric
          label="Comissões acumuladas"
          value={money(dashboard?.totals.commission_cents ?? 0)}
        />
        <Metric label="Aguardando pagamento" value={money(dashboard?.totals.pending_cents ?? 0)} />
        <Metric
          label="Clientes indicados"
          value={String(dashboard?.totals.referred_clients ?? 0)}
        />
        <Metric label="Assinaturas ativas" value={String(dashboard?.totals.active_clients ?? 0)} />
      </div>
      <Card>
        <CardHeader>
          <CardTitle>Links de indicação</CardTitle>
        </CardHeader>
        <CardContent className="grid gap-4 md:grid-cols-2">
          <LinkCard title="Landing page" value={links.home} onCopy={() => copy(links.home)} />
          <LinkCard
            title="Checkout com desconto de 10%"
            value={links.checkout}
            onCopy={() => copy(links.checkout)}
          />
          <p className="text-sm text-muted-foreground md:col-span-2">
            Cupom <strong className="text-foreground">{state.coupon?.code}</strong> · Comissão
            recorrente atual de {state.coupon?.commission_percent}%.
          </p>
        </CardContent>
      </Card>
      <Card>
        <CardHeader className="flex-row items-center justify-between space-y-0">
          <CardTitle>Clientes com acesso compartilhado</CardTitle>
          <ExportButtons onExport={exportClients} />
        </CardHeader>
        <CardContent>
          <p className="mb-4 flex items-center gap-2 text-sm text-muted-foreground">
            <ShieldCheck className="h-4 w-4 text-emerald-400" />
            Somente leitura. Os dados aparecem apenas após autorização expressa do cliente.
          </p>
          <div className="overflow-x-auto">
            <table className="w-full min-w-[900px] text-left text-sm">
              <thead>
                <tr className="border-b text-xs text-muted-foreground">
                  {[
                    "Cliente",
                    "Plano",
                    "Situação",
                    "Lançamentos",
                    "Receitas",
                    "Despesas",
                    "Acesso concedido",
                    "Relatório",
                  ].map((header) => (
                    <th key={header} className="px-3 py-3 font-medium">
                      {header}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {clientRows.length ? (
                  clientRows.map((client, index) => (
                    <tr key={`${client.client_name}-${index}`} className="border-b last:border-0">
                      <td className="px-3 py-3 font-medium">{client.client_name ?? "Cliente"}</td>
                      <td className="px-3 py-3">{client.plan}</td>
                      <td className="px-3 py-3">{client.status}</td>
                      <td className="num px-3 py-3">{client.entry_count}</td>
                      <td className="num px-3 py-3">{money(client.income_cents)}</td>
                      <td className="num px-3 py-3">{money(client.expense_cents)}</td>
                      <td className="px-3 py-3">
                        {new Date(client.shared_at).toLocaleDateString("pt-BR")}
                      </td>
                      <td className="px-3 py-3">
                        <details>
                          <summary className="cursor-pointer text-primary">Ver relatório</summary>
                          <div className="absolute z-10 mt-2 max-h-72 max-w-[min(90vw,42rem)] overflow-auto rounded-xl border bg-card p-3 shadow-xl">
                            <DataTable
                              headers={["Descrição", "Tipo", "Valor", "Vencimento", "Status"]}
                              rows={client.entries.map((entry) => [
                                entry.description,
                                entry.type === "income" ? "Entrada" : "Saída",
                                money(entry.amount_cents),
                                new Date(`${entry.due_date}T12:00:00`).toLocaleDateString("pt-BR"),
                                entry.status === "paid" ? "Pago" : "Pendente",
                              ])}
                              empty="Nenhum lançamento disponível."
                            />
                          </div>
                        </details>
                      </td>
                    </tr>
                  ))
                ) : (
                  <tr>
                    <td colSpan={8} className="px-3 py-8 text-center text-muted-foreground">
                      Nenhum cliente autorizou o compartilhamento ainda.
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </CardContent>
      </Card>
      <Card>
        <CardHeader className="flex-row items-center justify-between space-y-0">
          <CardTitle>Histórico de comissões e saques via PIX</CardTitle>
          <ExportButtons onExport={exportCommissions} />
        </CardHeader>
        <CardContent>
          <DataTable
            headers={["Cliente", "Comissão", "Status", "Criada em", "Paga em"]}
            rows={commissionRows.map((row) => Object.values(row))}
            empty="Nenhuma comissão registrada."
          />
        </CardContent>
      </Card>
      <p className="text-xs text-muted-foreground">
        Chave PIX cadastrada: {formatPixKeyType(state.pix_type ?? "")} · {state.pix_key}
      </p>
    </div>
  );
}

function Metric({ label, value }: { label: string; value: string }) {
  return (
    <Card>
      <CardHeader className="pb-2">
        <CardTitle className="text-sm font-medium text-muted-foreground">{label}</CardTitle>
      </CardHeader>
      <CardContent className="num text-2xl font-semibold">{value}</CardContent>
    </Card>
  );
}

function LinkCard({ title, value, onCopy }: { title: string; value: string; onCopy: () => void }) {
  return (
    <div className="flex min-w-0 items-center gap-3 rounded-xl border bg-muted/30 p-4">
      <div className="min-w-0 flex-1">
        <p className="text-xs text-muted-foreground">{title}</p>
