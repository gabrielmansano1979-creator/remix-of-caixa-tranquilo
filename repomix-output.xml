@layer base {
  * {
    border-color: var(--color-border);
  }
  html {
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    font-feature-settings:
      "ss01" on,
      "cv11" on;
  }
  body {
    background-color: var(--color-background);
    background-image:
      radial-gradient(ellipse at 14% -15%, oklch(0.48 0.12 250 / 0.12), transparent 42%),
      radial-gradient(ellipse at 100% 0%, oklch(0.42 0.08 160 / 0.08), transparent 38%);
    color: var(--color-foreground);
    min-height: 100vh;
  }
  :focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 2px;
  }

  .dark body {
    background-image:
      radial-gradient(ellipse at 14% -15%, oklch(0.48 0.12 250 / 0.12), transparent 42%),
      radial-gradient(ellipse at 100% 0%, oklch(0.42 0.08 160 / 0.08), transparent 38%);
  }

  ::selection {
    background: oklch(0.68 0.14 250 / 0.3);
  }

  .premium-surface {
    border: 1px solid color-mix(in oklch, var(--color-border) 82%, transparent);
    background: color-mix(in oklch, var(--color-card) 78%, transparent);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(18px);
  }

  .dark-surface {
    border: 1px solid rgb(255 255 255 / 0.09);
    background: rgb(24 28 36 / 0.68);
    backdrop-filter: blur(18px);
  }

  @keyframes criefyFadeUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .cash-reveal {
    animation: criefyFadeUp 450ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
}

@utility num {
  font-variant-numeric: tabular-nums;
}

@keyframes cc-float {
  0%,
  100% {
    transform: translateY(0) rotate(var(--r, 0deg));
  }
  50% {
    transform: translateY(-18px) rotate(var(--r, 0deg));
  }
}
@keyframes cc-marquee {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-50%);
  }
}
.float-a {
  --r: -4deg;
  animation: cc-float 7s ease-in-out infinite;
}
.float-b {
  --r: 3deg;
  animation: cc-float 9s ease-in-out infinite 1s;
}
.float-c {
  --r: -2deg;
  animation: cc-float 8s ease-in-out infinite 2s;
}
.marquee {
  animation: cc-marquee 40s linear infinite;
}
@media (prefers-reduced-motion: reduce) {
  .float-a,
  .float-b,
  .float-c,
  .marquee {
    animation: none;
  }
}

:root {
  --hero-ink: oklch(0.99 0 0);
  --hero-overlay: oklch(0.18 0.03 185 / 0.84);
}
.plg-hero {
  color: var(--hero-ink);
  min-height: 480px;
}
.plg-hero-shade {
  background: var(--hero-overlay);
}
