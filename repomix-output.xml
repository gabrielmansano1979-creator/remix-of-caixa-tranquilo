import { createFileRoute, Link } from "@tanstack/react-router";
import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
import { useState } from "react";
import { toast } from "sonner";
import { CartesianGrid, Line, LineChart, ReferenceArea, ReferenceLine, ResponsiveContainer, Tooltip, XAxis, YAxis } from "recharts";
import {
  AlertOctagon, AlertTriangle, CalendarDays, CheckCircle2, Circle, Inbox, MessageCircle, Pencil, RotateCcw, ShieldAlert, ShieldCheck, ShieldQuestion, TrendingDown, TrendingUp, Wallet,
} from "lucide-react";
import { supabase } from "@/integrations/supabase/client";
import { accessQuery, entriesQuery, parseDbError, profileQuery, todaySP } from "@/lib/app-data";
import { formatBRL, formatDate } from "@/lib/format";
import { createWhatsAppUrl } from "@/lib/whatsapp-message";
import { useMarkPaid } from "@/components/contas/shared";
import { MoneyInput } from "@/components/money-input";
import { Button } from "@/components/ui/button";
import { Skeleton } from "@/components/ui/skeleton";

export const Route = createFileRoute("/_authenticated/_app/caixa")({
  head: () => ({ meta: [{ title: "Caixa — Critical Cash" }, { name: "description", content: "Confira a previsão do seu caixa para os próximos 30 dias." }, { property: "og:title", content: "Caixa — Critical Cash" }, { property: "og:description", content: "Confira a previsão do seu caixa para os próximos 30 dias." }, { property: "og:type", content: "website" }, { name: "twitter:card", content: "summary" }, { name: "robots", content: "noindex" }] }),
  component: CaixaPage,
});

type Projection = { today: string; current: number; series: { date: string; balance: number }[]; min_balance: number; min_date: string; cushion: number; status: "green" | "yellow" | "red" };
type Risk = { entry_id: string; description: string; counterparty_name: string | null; counterparty_whatsapp: string | null; amount_cents: number; due_date: string; level: "high" | "medium" | "low"; reason: string };

const projectionQuery = { queryKey: ["projection"], queryFn: async () => {
  const { data, error } = await supabase.rpc("cash_projection", { _days: 30 });
  if (error) throw error;
  return data as unknown as Projection;
} };

function CaixaPage() {
  const proj = useQuery(projectionQuery);
  const entries = useQuery(entriesQuery);
  const access = useQuery(accessQuery);

  if (proj.isLoading || entries.isLoading) {
    return <div className="space-y-4"><Skeleton className="h-32 rounded-2xl" /><div className="grid gap-4 sm:grid-cols-2"><Skeleton className="h-32 rounded-2xl" /><Skeleton className="h-32 rounded-2xl" /></div><Skeleton className="h-64 rounded-2xl" /></div>;
  }
  if (proj.isError || entries.isError) {
    return (
      <div className="flex flex-col items-center rounded-2xl border bg-card p-10 text-center">
        <AlertTriangle className="h-8 w-8 text-danger" />
        <p className="mt-3">Não foi possível calcular sua projeção.</p>
        <Button variant="outline" className="mt-4 h-11 rounded-xl" onClick={() => { proj.refetch(); entries.refetch(); }}><RotateCcw className="mr-2 h-4 w-4" />Tentar novamente</Button>
      </div>
    );
  }
  const p = proj.data;
  if (!p) return null;
  const hasEntries = (entries.data?.length ?? 0) > 0;

  return (
    <div className="space-y-8">
      <div className="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p className="text-[11px] font-bold uppercase tracking-[0.2em] text-primary">Painel financeiro</p>
          <h1 className="mt-2 text-3xl font-bold tracking-tight md:text-4xl">Visão do caixa</h1>
          <p className="mt-2 text-sm text-muted-foreground md:text-base">Antecipe movimentos e mantenha o controle dos próximos 30 dias.</p>
        </div>
        <span className="mb-1 inline-flex items-center gap-2 rounded-full border border-success/20 bg-success/5 px-3 py-2 text-xs font-semibold text-success">
          <span className="h-1.5 w-1.5 rounded-full bg-success" /> Dados atualizados
        </span>
      </div>
      <Activation hasEntries={hasEntries} />
      {!hasEntries ? (
        <div className="flex flex-col items-center rounded-2xl border bg-card p-10 text-center shadow-[var(--shadow-soft)]">
          <span className="grid h-16 w-16 place-items-center rounded-full bg-accent text-accent-foreground"><Inbox className="h-8 w-8" /></span>
          <h2 className="mt-4 text-lg font-semibold">Vamos ver se o seu caixa fecha?</h2>
          <p className="mt-1 max-w-sm text-sm text-muted-foreground">Cadastre o que você tem a receber e a pagar nos próximos 30 dias.</p>
          <div className="mt-5 flex gap-2">
            <Button asChild className="h-11 rounded-xl"><Link to="/contas" search={{ novo: 1 }}>Cadastrar conta</Link></Button>
            <Button asChild variant="outline" className="h-11 rounded-xl"><Link to="/contas" search={{ importar: 1 }}>Importar CSV</Link></Button>
          </div>
          <div className="mt-8 w-full max-w-sm text-left"><BalanceCard current={p.current} /></div>
        </div>
      ) : (
        <>
          <Semaphore p={p} />
          <div className="grid gap-5 md:grid-cols-3">
            <BalanceCard current={p.current} />
            <ProjCard label="Saldo projetado em 15 dias" value={p.series[15]?.balance ?? p.current} current={p.current} />
            <ProjCard label="Saldo projetado em 30 dias" value={p.series[30]?.balance ?? p.current} current={p.current} />
          </div>
          <Chart p={p} />
          <Risks limit={access.data?.limits.top_risks ?? 5} canWrite={access.data?.can_write ?? true} />
        </>
      )}
    </div>
  );
}

function Semaphore({ p }: { p: Projection }) {
  const cfg = {
    red: { icon: AlertOctagon, title: "Risco: o caixa não fecha", cls: "bg-danger/10 text-danger border-danger/30", msg: `Seu caixa fica negativo em ${formatDate(p.min_date)} (${formatBRL(p.min_balance)}).` },
    yellow: { icon: AlertTriangle, title: "Atenção: caixa apertado", cls: "bg-warning/10 text-warning border-warning/30", msg: `O pior dia é ${formatDate(p.min_date)}, com ${formatBRL(p.min_balance)} — abaixo da sua reserva de ${formatBRL(p.cushion)}.` },
    green: { icon: CheckCircle2, title: "Tudo certo: o caixa fecha", cls: "bg-success/10 text-success border-success/30", msg: `Nos próximos 30 dias o menor saldo é ${formatBRL(p.min_balance)}, em ${formatDate(p.min_date)}.` },
  }[p.status];
  return (
    <section className={`cash-reveal flex items-start gap-4 rounded-2xl border p-6 shadow-[var(--shadow-soft)] md:p-7 ${cfg.cls}`} aria-live="polite">
      <span className="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-background/60 shadow-sm">
        <cfg.icon className="h-6 w-6" aria-hidden="true" />
      </span>
      <div>
        <h2 className="text-xl font-semibold md:text-2xl">{cfg.title}</h2>
        <p className="mt-1 text-foreground">{cfg.msg}</p>
      </div>
    </section>
  );
}

function BalanceCard({ current }: { current: number }) {
  const qc = useQueryClient();
  const profile = useQuery(profileQuery);
  const [edit, setEdit] = useState(false);
  const [v, setV] = useState(current);
  const save = useMutation({
    mutationFn: async () => {
      if (!profile.data) throw new Error("Perfil indisponível");
      const { error } = await supabase.from("profiles").update({ initial_balance_cents: v, balance_date: todaySP() }).eq("user_id", profile.data.user_id);
      if (error) throw error;
    },
    onSuccess: () => { qc.invalidateQueries({ queryKey: ["projection"] }); qc.invalidateQueries({ queryKey: ["profile"] }); setEdit(false); toast.success("Saldo atualizado."); },
    onError: (e) => toast.error(parseDbError(e).message),
  });
  return (
    <div className="premium-surface rounded-2xl p-6 md:p-7">
      <div className="flex items-center justify-between">
        <div className="flex items-center gap-3">
          <span className="grid h-10 w-10 place-items-center rounded-xl bg-primary/10 text-primary"><Wallet className="h-5 w-5" /></span>
          <div><p className="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Saldo atual</p><p className="mt-0.5 text-xs text-muted-foreground">Posição de caixa</p></div>
        </div>
        {!edit && <Button variant="ghost" size="sm" className="h-10 rounded-xl" onClick={() => { setV(current); setEdit(true); }}><Pencil className="mr-1 h-3.5 w-3.5" />Editar</Button>}
      </div>
      {edit ? (
        <form className="mt-1" onSubmit={(e) => { e.preventDefault(); save.mutate(); }}>
          <label htmlFor="bal" className="sr-only">Saldo atual</label>
          <MoneyInput id="bal" value={v} onChange={setV} allowNegative />
          <div className="mt-2 flex gap-2">
            <Button type="submit" size="sm" className="h-10 rounded-lg" disabled={save.isPending}>Salvar</Button>
            <Button type="button" size="sm" variant="ghost" className="h-10" onClick={() => setEdit(false)}>Cancelar</Button>
          </div>
        </form>
      ) : (
        <>
          <p className={`num mt-5 text-[2.25rem] font-bold leading-tight tracking-tight ${current < 0 ? "text-danger" : ""}`}>{formatBRL(current)}</p>
          {profile.data?.balance_date && <p className="text-xs text-muted-foreground">Atualizado em {formatDate(profile.data.balance_date)}</p>}
        </>
      )}
    </div>
  );
}

function ProjCard({ label, value, current }: { label: string; value: number; current: number }) {
  const diff = value - current;
  const up = diff >= 0;
  return (
    <div className="premium-surface rounded-2xl p-6 md:p-7">
      <div className="flex items-center gap-3">
        <span className={`grid h-10 w-10 place-items-center rounded-xl ${up ? "bg-success/10 text-success" : "bg-warning/10 text-warning"}`}><CalendarDays className="h-5 w-5" /></span>
        <p className="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{label}</p>
      </div>
      <p className={`num mt-5 text-[2.25rem] font-bold leading-tight tracking-tight ${value < 0 ? "text-danger" : ""}`}>{formatBRL(value)}</p>
      <p className={`mt-1 flex items-center gap-1 text-sm ${up ? "text-success" : "text-danger"}`}>
        {up ? <TrendingUp className="h-4 w-4" /> : <TrendingDown className="h-4 w-4" />}
        <span className="num">{up ? "+" : "−"}{formatBRL(Math.abs(diff))}</span> <span className="text-muted-foreground">vs. hoje</span>
      </p>
    </div>
  );
}

function Chart({ p }: { p: Projection }) {
  const data = p.series.map((s) => ({ d: formatDate(s.date).slice(0, 5), v: s.balance / 100 }));
  const min = Math.min(0, ...data.map((d) => d.v));
  const max = Math.max(0, ...data.map((d) => d.v));
  const fmt = (n: number) => new Intl.NumberFormat("pt-BR", { notation: "compact", style: "currency", currency: "BRL" }).format(n);
  return (
    <section className="premium-surface rounded-2xl p-6 md:p-7">
      <div className="flex flex-wrap items-center justify-between gap-3">
        <div><p className="text-[11px] font-bold uppercase tracking-[0.18em] text-primary">Projeção</p><h2 className="mt-1 text-lg font-semibold tracking-tight">Saldo nos próximos 30 dias</h2></div>
        <span className="rounded-full border border-border/80 bg-background/70 px-3 py-1.5 text-xs font-medium text-muted-foreground">Atualização diária</span>
      </div>
      <div className="mt-4 h-64" role="img" aria-label={`Gráfico do saldo projetado. Menor saldo ${formatBRL(p.min_balance)} em ${formatDate(p.min_date)}.`}>
        <ResponsiveContainer width="100%" height="100%">
          <LineChart data={data} margin={{ top: 8, right: 8, bottom: 0, left: 0 }}>
            <CartesianGrid stroke="var(--border)" vertical={false} />
            <XAxis dataKey="d" tick={{ fontSize: 11, fill: "var(--muted-foreground)" }} interval={4} tickLine={false} axisLine={false} />
            <YAxis tickFormatter={fmt} tick={{ fontSize: 11, fill: "var(--muted-foreground)" }} width={70} tickLine={false} axisLine={false} domain={[min * 1.1, max * 1.1]} />
            {min < 0 && <ReferenceArea y1={min * 1.1} y2={0} fill="var(--danger)" fillOpacity={0.08} />}
            <ReferenceLine y={0} stroke="var(--danger)" strokeWidth={1.5} strokeDasharray="4 4" />
            <Tooltip formatter={(v: number) => [formatBRL(Math.round(v * 100)), "Saldo"]} contentStyle={{ borderRadius: 12, border: "1px solid var(--border)", background: "var(--popover)", color: "var(--popover-foreground)" }} />
            <Line type="monotone" dataKey="v" stroke="var(--primary)" strokeWidth={2.5} dot={false} />
          </LineChart>
        </ResponsiveContainer>
      </div>
    </section>
  );
}

function Risks({ limit, canWrite }: { limit: number; canWrite: boolean }) {
  const risks = useQuery({ queryKey: ["risks", limit], queryFn: async () => {
    const { data, error } = await supabase.rpc("top_risks", { _limit: limit });
    if (error) throw error;
    return data as Risk[];
  } });
  const markPaid = useMarkPaid();
  const openWhatsApp = (risk: Risk) => {
    const url = createWhatsAppUrl({
      counterparty_name: risk.counterparty_name,
      counterparty_whatsapp: risk.counterparty_whatsapp,
      amount_cents: risk.amount_cents,
      due_date: risk.due_date,
      description: risk.description,
    }, `Olá, ${risk.counterparty_name || "cliente"}! Passando para lembrar que ${risk.description}, no valor de ${formatBRL(risk.amount_cents)}, vence em ${formatDate(risk.due_date)}. ${risk.reason} Se já realizou o pagamento, desconsidere esta mensagem.`);
    if (!url) {
      toast.error("Cadastre um número de WhatsApp válido para esta conta.");
      return;
    }
    window.open(url, "_blank", "noopener,noreferrer");
  };
  const badge = {
    high: { icon: ShieldAlert, label: "Alto", cls: "bg-danger/10 text-danger" },
    medium: { icon: ShieldQuestion, label: "Médio", cls: "bg-warning/10 text-warning" },
    low: { icon: ShieldCheck, label: "Baixo", cls: "bg-success/10 text-success" },
  };
  return (
    <section className="premium-surface rounded-2xl p-6 md:p-7">
      <div className="flex items-center justify-between gap-3"><div><p className="text-[11px] font-bold uppercase tracking-[0.18em] text-primary">Acompanhamento</p><h2 className="mt-1 text-lg font-semibold tracking-tight">Contas que exigem atenção</h2></div><ShieldAlert className="h-5 w-5 text-warning" /></div>
      {risks.isLoading ? <div className="mt-4 space-y-2"><Skeleton className="h-16 rounded-xl" /><Skeleton className="h-16 rounded-xl" /></div>
        : risks.isError ? <div className="mt-4 text-sm text-danger">Erro ao carregar riscos. <button className="underline" onClick={() => risks.refetch()}>Tentar novamente</button></div>
        : !risks.data?.length ? <p className="mt-4 text-sm text-muted-foreground">Nenhuma conta a receber pendente nos próximos 30 dias.</p>
        : (
          <ul className="mt-5 divide-y divide-border/70">
            {risks.data.map((r) => {
              const b = badge[r.level];
              return (
                <li key={r.entry_id} className="flex flex-col gap-4 py-5 sm:flex-row sm:items-center">
                  <div className="min-w-0 flex-1">
                    <div className="flex flex-wrap items-center gap-2">
                      <span className={`inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium ${b.cls}`}><b.icon className="h-3.5 w-3.5" />{b.label}</span>
                      <span className="font-medium">{r.counterparty_name || r.description}</span>
                      <span className="num font-semibold text-success">+{formatBRL(r.amount_cents)}</span>
                    </div>
                    <p className="mt-1 text-sm text-muted-foreground">{r.reason} Venc. {formatDate(r.due_date)}.</p>
                  </div>
                  <div className="flex gap-2">
                    <Button size="sm" variant="outline" className="h-10 rounded-lg" disabled={!canWrite || !r.counterparty_whatsapp} onClick={() => openWhatsApp(r)}><MessageCircle className="mr-1 h-4 w-4" />Enviar via WhatsApp</Button>
                    <Button size="sm" variant="ghost" className="h-10 rounded-lg text-success" disabled={!canWrite} onClick={() => markPaid.mutate({ id: r.entry_id, paid: true })}><CheckCircle2 className="mr-1 h-4 w-4" />Pago</Button>
                  </div>
                </li>
              );
            })}
          </ul>
        )}
    </section>
  );
}

function Activation({ hasEntries }: { hasEntries: boolean }) {
  const q = useQuery({ queryKey: ["activation"], queryFn: async () => {
    const { count: rules } = await supabase.from("reminder_rules").select("id", { count: "exact", head: true }).eq("active", true);
    return { rules: (rules ?? 0) > 0 };
  } });
  if (!q.data) return null;
  const steps = [
    { done: hasEntries, label: "Cadastre sua primeira conta", to: "/contas" as const },
    { done: q.data.rules, label: "Prepare suas mensagens de cobrança", to: "/lembretes" as const },
  ];
  if (steps.every((s) => s.done)) return null;
  return (
    <section className="rounded-2xl border bg-card p-5">
      <h2 className="text-sm font-semibold">Primeiros passos · {steps.filter((s) => s.done).length}/3</h2>
      <ol className="mt-3 grid gap-2 sm:grid-cols-2">
        {steps.map((s, i) => (
          <li key={s.label}>
            <Link to={s.to} className="flex min-h-11 items-center gap-2 rounded-xl border px-3 py-2 text-sm hover:bg-accent">
              {s.done ? <CheckCircle2 className="h-4 w-4 text-success" /> : <Circle className="h-4 w-4 text-muted-foreground" />}
              <span className={s.done ? "text-muted-foreground line-through" : ""}>{i + 1}. {s.label}</span>
            </Link>
          </li>
        ))}
      </ol>
    </section>
  );
}
</file>

<file path="src/routes/_authenticated/_app/contas.tsx">
import { createFileRoute, useNavigate } from "@tanstack/react-router";
import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
import { useEffect, useMemo, useState } from "react";
import { z } from "zod";
import { toast } from "sonner";
import {
  AlertTriangle, CheckCircle2, Clock, FileUp, MoreVertical, Pencil, Plus, Search, Trash2, Inbox, RotateCcw, MessageCircle, ArrowDownToLine, ArrowUpFromLine,
} from "lucide-react";
import { supabase } from "@/integrations/supabase/client";
import { accessQuery, profileQuery, entriesQuery, isOverdue, parseDbError, todaySP, type Entry, type LimitKind } from "@/lib/app-data";
import { formatBRL, formatDate } from "@/lib/format";
import { USAGE_WARNING_RATIO } from "@/config/plans";
import { StatusBadge, useMarkPaid } from "@/components/contas/shared";
import { EntryFormDialog } from "@/components/contas/entry-form";
import { CsvImportDialog } from "@/components/contas/csv-import";
import { WhatsAppComposeDialog } from "@/components/whatsapp-compose-dialog";
import { UpgradeDialog } from "@/components/upgrade-dialog";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Tabs, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { Skeleton } from "@/components/ui/skeleton";
import { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuSeparator, DropdownMenuTrigger } from "@/components/ui/dropdown-menu";
import { AlertDialog, AlertDialogAction, AlertDialogCancel, AlertDialogContent, AlertDialogDescription, AlertDialogFooter, AlertDialogHeader, AlertDialogTitle } from "@/components/ui/alert-dialog";
import { Sheet, SheetContent, SheetHeader, SheetTitle } from "@/components/ui/sheet";

export const Route = createFileRoute("/_authenticated/_app/contas")({
  validateSearch: z.object({ novo: z.number().optional(), importar: z.number().optional() }),
  head: () => ({ meta: [{ title: "Contas — Critical Cash" }, { name: "description", content: "Acompanhe suas contas, vencimentos e envios de cobrança." }, { property: "og:title", content: "Contas — Critical Cash" }, { property: "og:description", content: "Acompanhe suas contas, vencimentos e envios de cobrança." }, { property: "og:type", content: "website" }, { name: "twitter:card", content: "summary" }, { name: "robots", content: "noindex" }] }),
  component: ContasPage,
});

type Status = "all" | "pending" | "paid" | "overdue";

function ContasPage() {
  const search = Route.useSearch();
  const navigate = useNavigate({ from: "/contas" });
  const qc = useQueryClient();
  const { data, isLoading, isError, refetch } = useQuery(entriesQuery);
  const { data: access } = useQuery(accessQuery);
  const { data: profile } = useQuery(profileQuery);
  const [tab, setTab] = useState<"all" | "income" | "expense">("all");
  const [status, setStatus] = useState<Status>("all");
  const [q, setQ] = useState("");
  const [formOpen, setFormOpen] = useState(false);
  const [editing, setEditing] = useState<Entry | null>(null);
  const [csvOpen, setCsvOpen] = useState(false);
  const [del, setDel] = useState<Entry | null>(null);
  const [detail, setDetail] = useState<Entry | null>(null);
  const [whatsAppOpen, setWhatsAppOpen] = useState(false);
  const [whatsAppEntry, setWhatsAppEntry] = useState<Entry | null>(null);
  const [limit, setLimit] = useState<string | null>(null);
  const markPaid = useMarkPaid();
  const canWrite = access?.can_write ?? true;

  useEffect(() => {
    if (search.novo) setFormOpen(true);
    if (search.importar) setCsvOpen(true);
    if (search.novo || search.importar) navigate({ search: {}, replace: true });
  }, [search.novo, search.importar, navigate]);

  const onLimit = (_k: LimitKind, msg: string) => setLimit(msg);
  const guard = (fn: () => void) => () => (canWrite ? fn() : setLimit("Seu teste grátis terminou e a conta está em modo somente leitura."));

  const pendingCount = data?.filter((e) => e.status === "pending").length ?? 0;
  const pendingLimit = access?.limits.pending_entries ?? Infinity;

  const rows = useMemo(() => {
    const term = q.trim().toLowerCase();
    return (data ?? []).filter((e) =>
      (tab === "all" || e.type === tab) &&
      (status === "all" || (status === "overdue" ? isOverdue(e) : status === "pending" ? e.status === "pending" && !isOverdue(e) : e.status === "paid")) &&
      (!term || (e.counterparty_name ?? "").toLowerCase().includes(term) || e.description.toLowerCase().includes(term)));
  }, [data, tab, status, q]);

  const remove = useMutation({
    mutationFn: async (id: string) => {
      const { error } = await supabase.from("entries").delete().eq("id", id);
      if (error) throw error;
    },
    onSuccess: () => { qc.invalidateQueries({ queryKey: ["entries"] }); qc.invalidateQueries({ queryKey: ["projection"] }); toast.success("Conta excluída."); },
    onError: (e) => toast.error(parseDbError(e).message),
  });

  return (
    <div className="space-y-1">
      <div className="flex flex-wrap items-end justify-between gap-3">
        <div>
          <p className="text-[11px] font-bold uppercase tracking-[0.2em] text-primary">Movimentações</p>
          <h1 className="mt-2 text-3xl font-bold tracking-tight md:text-4xl">Contas</h1>
          <p className="mt-2 text-sm text-muted-foreground md:text-base">Uma visão clara do que entra e sai do seu caixa.</p>
        </div>
        <div className="flex gap-2">
          <Button variant="outline" className="h-11 rounded-xl border-success/25 text-success hover:bg-success/10 hover:text-success" onClick={guard(() => { setWhatsAppEntry(null); setWhatsAppOpen(true); })}>
            <MessageCircle className="mr-2 h-4 w-4" />Enviar WhatsApp
          </Button>
          <Button variant="outline" className="h-11 rounded-xl" onClick={guard(() => setCsvOpen(true))}><FileUp className="mr-2 h-4 w-4" />Importar arquivo</Button>
          <Button className="h-11 rounded-xl px-5" onClick={guard(() => { setEditing(null); setFormOpen(true); })}><Plus className="mr-2 h-4 w-4" />Nova conta</Button>
        </div>
      </div>

      {access && pendingCount >= pendingLimit * USAGE_WARNING_RATIO && (
        <div className="mt-4 flex items-center gap-2 rounded-xl bg-warning/10 p-3 text-sm text-warning" role="status">
          <AlertTriangle className="h-4 w-4 shrink-0" />
          Você está usando {pendingCount} de {pendingLimit} contas pendentes do seu plano.
        </div>
      )}

      <div className="mt-8 flex flex-col gap-4 rounded-2xl border border-border/70 bg-card/65 p-4 shadow-sm backdrop-blur md:flex-row md:items-center md:p-5">
        <Tabs value={tab} onValueChange={(v) => setTab(v as typeof tab)}>
          <TabsList className="h-11 rounded-xl">
            <TabsTrigger value="all" className="h-9 rounded-lg">Todas</TabsTrigger>
            <TabsTrigger value="income" className="h-9 rounded-lg">A receber</TabsTrigger>
            <TabsTrigger value="expense" className="h-9 rounded-lg">A pagar</TabsTrigger>
          </TabsList>
        </Tabs>
        <div className="flex flex-1 gap-2">
          <Select value={status} onValueChange={(v) => setStatus(v as Status)}>
            <SelectTrigger className="h-11 w-40 rounded-xl" aria-label="Filtrar por status"><SelectValue /></SelectTrigger>
            <SelectContent>
              <SelectItem value="all">Todos status</SelectItem>
              <SelectItem value="pending">Pendente</SelectItem>
              <SelectItem value="overdue">Atrasado</SelectItem>
              <SelectItem value="paid">Pago</SelectItem>
            </SelectContent>
          </Select>
          <div className="relative flex-1">
            <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
            <Input aria-label="Buscar por nome" placeholder="Buscar por nome…" value={q} onChange={(e) => setQ(e.target.value)} className="h-11 rounded-xl pl-9" />
          </div>
        </div>
      </div>

      <div className="mt-5 overflow-hidden rounded-2xl border border-border/75 bg-card/85 shadow-[var(--shadow-soft)] backdrop-blur-xl">
        {isLoading ? (
          <div className="space-y-3 p-6">{Array.from({ length: 6 }).map((_, i) => <Skeleton key={i} className="h-14 rounded-xl" />)}</div>
        ) : isError ? (
          <div className="flex flex-col items-center p-10 text-center">
            <AlertTriangle className="h-8 w-8 text-danger" />
            <p className="mt-3 text-sm">Não foi possível carregar suas contas.</p>
            <Button variant="outline" className="mt-4 h-11 rounded-xl" onClick={() => refetch()}><RotateCcw className="mr-2 h-4 w-4" />Tentar novamente</Button>
          </div>
        ) : !data?.length ? (
          <div className="flex flex-col items-center p-10 text-center">
            <span className="grid h-16 w-16 place-items-center rounded-full bg-accent text-accent-foreground"><Inbox className="h-8 w-8" /></span>
            <h2 className="mt-4 font-semibold">Nenhuma conta ainda</h2>
            <p className="mt-1 max-w-xs text-sm text-muted-foreground">Cadastre o que você tem a receber e a pagar para ver se o caixa fecha.</p>
            <div className="mt-5 flex gap-2">
              <Button className="h-11 rounded-xl" onClick={guard(() => setFormOpen(true))}>Cadastrar conta</Button>
              <Button variant="outline" className="h-11 rounded-xl" onClick={guard(() => setCsvOpen(true))}>Importar CSV</Button>
            </div>
          </div>
        ) : !rows.length ? (
          <p className="p-10 text-center text-sm text-muted-foreground">Nenhuma conta encontrada com esses filtros.</p>
        ) : (
          <table className="w-full text-sm md:[&_td]:py-4">
            <thead className="hidden bg-muted/45 text-left text-[11px] uppercase tracking-wider text-muted-foreground md:table-header-group">
              <tr className="border-b border-border/70"><th className="px-5 py-4 font-semibold">Vencimento</th><th className="px-5 py-4 font-semibold">Nome</th><th className="px-5 py-4 font-semibold">Descrição</th><th className="px-5 py-4 text-right font-semibold">Valor</th><th className="px-5 py-4 font-semibold">Status</th><th className="w-24 p-3" /></tr>
            </thead>
            <tbody>
              {rows.map((e) => (
                <tr key={e.id} className="grid grid-cols-[1fr_auto] gap-x-3 border-b border-border/60 p-4 transition-colors last:border-0 hover:bg-accent/25 md:table-row md:p-0">
                  <td className="num text-xs text-muted-foreground md:px-5 md:text-sm md:text-foreground">{formatDate(e.due_date)}</td>
                  <td className="col-start-1 font-semibold md:px-5">
                    <button className="text-left transition-colors hover:text-primary hover:underline" onClick={() => setDetail(e)}>{e.counterparty_name || "—"}</button>
                  </td>
                  <td className="col-start-1 text-muted-foreground md:px-5">{e.description}</td>
                  <td className={`num col-start-2 row-span-2 row-start-1 self-center text-right text-base font-bold tracking-tight md:px-5 ${e.type === "income" ? "text-success" : "text-foreground"}`}>
                    {e.type === "income" ? <ArrowDownToLine className="mr-1 inline h-3.5 w-3.5" /> : <ArrowUpFromLine className="mr-1 inline h-3.5 w-3.5" />}
                    {e.type === "income" ? "+" : "−"}{formatBRL(e.amount_cents)}
                  </td>
                  <td className="col-start-1 md:px-5"><StatusBadge e={e} /></td>
                  <td className="col-start-2 row-start-3 flex items-center justify-end gap-1 md:px-5">
                    {e.status === "pending" && (
                      <Button size="sm" variant="ghost" className="h-10 rounded-lg text-success" onClick={guard(() => markPaid.mutate({ id: e.id, paid: true }))} aria-label="Marcar como pago">
                        <CheckCircle2 className="h-4 w-4 md:mr-1" /><span className="hidden lg:inline">Pago</span>
                      </Button>
                    )}
                    <DropdownMenu>
                      <DropdownMenuTrigger asChild><Button size="icon" variant="ghost" className="h-10 w-10" aria-label="Ações"><MoreVertical className="h-4 w-4" /></Button></DropdownMenuTrigger>
                      <DropdownMenuContent align="end" className="rounded-xl">
                        <DropdownMenuItem onClick={() => setDetail(e)}>Ver detalhes</DropdownMenuItem>
                        {e.type === "income" && e.status === "pending" && e.counterparty_whatsapp && <DropdownMenuItem disabled={!canWrite} onClick={guard(() => { setWhatsAppEntry(e); setWhatsAppOpen(true); })}><MessageCircle className="mr-2 h-4 w-4" />Cobrar pelo WhatsApp</DropdownMenuItem>}
                        <DropdownMenuItem onClick={guard(() => { setEditing(e); setFormOpen(true); })}><Pencil className="mr-2 h-4 w-4" />Editar</DropdownMenuItem>
                        {e.status === "paid" && <DropdownMenuItem onClick={guard(() => markPaid.mutate({ id: e.id, paid: false }))}><RotateCcw className="mr-2 h-4 w-4" />Reabrir</DropdownMenuItem>}
                        <DropdownMenuSeparator />
                        <DropdownMenuItem className="text-danger" onClick={guard(() => setDel(e))}><Trash2 className="mr-2 h-4 w-4" />Excluir</DropdownMenuItem>
                      </DropdownMenuContent>
                    </DropdownMenu>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>

      <EntryFormDialog open={formOpen} onOpenChange={setFormOpen} entry={editing} onLimit={onLimit} />
      <CsvImportDialog open={csvOpen} onOpenChange={setCsvOpen} onLimit={onLimit} />
      <WhatsAppComposeDialog entries={data ?? []} open={whatsAppOpen} onOpenChange={setWhatsAppOpen} initialEntry={whatsAppEntry} />
      <UpgradeDialog open={!!limit} onOpenChange={(o) => !o && setLimit(null)} message={limit ?? ""} />
      <EntryDetail entry={detail} onClose={() => setDetail(null)} />

      <AlertDialog open={!!del} onOpenChange={(o) => !o && setDel(null)}>
        <AlertDialogContent className="rounded-2xl">
          <AlertDialogHeader>
            <AlertDialogTitle>Excluir esta conta?</AlertDialogTitle>
            <AlertDialogDescription>“{del?.description}” será removida e os lembretes dela param. Não dá para desfazer.</AlertDialogDescription>
          </AlertDialogHeader>
          <AlertDialogFooter>
            <AlertDialogCancel className="h-11 rounded-xl">Cancelar</AlertDialogCancel>
            <AlertDialogAction className="h-11 rounded-xl bg-danger text-danger-foreground hover:bg-danger/90" onClick={() => del && remove.mutate(del.id)}>Excluir</AlertDialogAction>
          </AlertDialogFooter>
        </AlertDialogContent>
      </AlertDialog>
    </div>
  );
}

function EntryDetail({ entry, onClose }: { entry: Entry | null; onClose: () => void }) {
  const logs = useQuery({
    queryKey: ["logs", entry?.id],
    enabled: !!entry,
    queryFn: async () => {
      if (!entry) return [];
      const { data, error } = await supabase.from("reminder_logs").select("id, status, channel, sent_to, sent_at, error, reminder_rules!reminder_logs_stage_rule_id_fkey(label)").eq("entry_id", entry.id).order("sent_at", { ascending: false });
      if (error) throw error;
      return data;
    },
  });
  return (
    <Sheet open={!!entry} onOpenChange={(o) => !o && onClose()}>
      <SheetContent className="w-full overflow-y-auto sm:max-w-md">
        {entry && (
          <>
            <SheetHeader><SheetTitle>{entry.description}</SheetTitle></SheetHeader>
            <dl className="mt-6 grid grid-cols-2 gap-4 text-sm">
              <div><dt className="text-muted-foreground">Valor</dt><dd className={`num text-lg font-semibold ${entry.type === "income" ? "text-success" : "text-danger"}`}>{entry.type === "income" ? "+" : "−"}{formatBRL(entry.amount_cents)}</dd></div>
              <div><dt className="text-muted-foreground">Status</dt><dd><StatusBadge e={entry} /></dd></div>
              <div><dt className="text-muted-foreground">Vencimento</dt><dd className="num">{formatDate(entry.due_date)}</dd></div>
              <div><dt className="text-muted-foreground">Pago em</dt><dd className="num">{entry.paid_at ? formatDate(entry.paid_at) : "—"}</dd></div>
              <div className="col-span-2"><dt className="text-muted-foreground">{entry.type === "income" ? "Cliente" : "Fornecedor"}</dt><dd>{entry.counterparty_name || "—"} {entry.counterparty_whatsapp && <span className="text-muted-foreground">· WhatsApp {entry.counterparty_whatsapp}</span>}</dd></div>
            </dl>
            {entry.type === "income" && (
              <div className="mt-8">
                <h3 className="font-semibold">Histórico de lembretes</h3>
                {logs.isLoading ? <Skeleton className="mt-3 h-16 rounded-xl" /> : logs.isError ? (
                  <p className="mt-3 text-sm text-danger">Erro ao carregar histórico.</p>
                ) : !logs.data?.length ? (
                  <p className="mt-3 text-sm text-muted-foreground">Nenhum lembrete enviado ainda{entry.reminders_muted ? " (lembretes pausados)" : ""}.</p>
                ) : (
                  <ul className="mt-3 space-y-2">
                    {logs.data.map((l) => (
                      <li key={l.id} className="flex items-start justify-between gap-3 rounded-xl border p-3 text-sm">
                        <div><p className="font-medium">{(l.reminder_rules as { label?: string } | null)?.label ?? "Cobrança manual"}</p><p className="text-xs text-muted-foreground">{new Date(l.sent_at).toLocaleString("pt-BR", { timeZone: "America/Sao_Paulo" })}</p></div>
                        {l.status === "sent"
                          ? <span className="flex items-center gap-1 text-success"><CheckCircle2 className="h-4 w-4" />Enviado</span>
                          : <span className="flex items-center gap-1 text-danger"><AlertTriangle className="h-4 w-4" />{l.status === "bounced" ? "Devolvido" : "Falhou"}</span>}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            )}
          </>
        )}
      </SheetContent>
    </Sheet>
  );
}
</file>

<file path="src/routes/_authenticated/_app/lembretes.tsx">
import { createFileRoute, Link } from "@tanstack/react-router";
import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
import { useEffect, useRef, useState } from "react";
import { toast } from "sonner";
import { AlertTriangle, CheckCircle2, Lock, MessageCircle, RotateCcw } from "lucide-react";
import { supabase } from "@/integrations/supabase/client";
import { parseDbError } from "@/lib/app-data";
import { useEntitlements } from "@/hooks/use-entitlements";
import { ReminderPreview } from "@/components/reminder-preview";
import { formatBRL } from "@/lib/format";
import { Button } from "@/components/ui/button";
import { Switch } from "@/components/ui/switch";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import { Label } from "@/components/ui/label";
import { Skeleton } from "@/components/ui/skeleton";

export const Route = createFileRoute("/_authenticated/_app/lembretes")({
  head: () => ({ meta: [{ title: "Lembretes — Critical Cash" }, { name: "description", content: "Configure mensagens de cobrança para enviar pelo WhatsApp." }, { property: "og:title", content: "Lembretes — Critical Cash" }, { property: "og:description", content: "Configure mensagens de cobrança para enviar pelo WhatsApp." }, { property: "og:type", content: "website" }, { name: "twitter:card", content: "summary" }, { name: "robots", content: "noindex" }] }),
  component: LembretesPage,
});

type Rule = { id: string; label: string; offset_days: number; body_tpl: string; active: boolean };
const VARS = ["cliente", "valor", "vencimento", "descricao", "empresa", "link_pix"] as const;
const offsetLabel = (n: number) => (n < 0 ? `${-n} dia(s) antes` : n === 0 ? "No dia do vencimento" : `${n} dia(s) após`);

function preview(tpl: string, empresa: string) {
  const v: Record<string, string> = { cliente: "Maria Silva", valor: formatBRL(150000), vencimento: "15/10/2026", descricao: "Consultoria de outubro", empresa };
  return tpl.replace(/\{\{\s*(\w+)\s*\}\}/g, (_m, k: string) => v[k] ?? `{{${k}}}`);
}

function LembretesPage() {
  const ent = useEntitlements();
  const rules = useQuery({ queryKey: ["rules"], queryFn: async () => {
    const { data, error } = await supabase.from("reminder_rules").select("*").order("offset_days");
    if (error) throw error;
    return data as Rule[];
  } });
  const profile = useQuery({ queryKey: ["profile-lite"], queryFn: async () => (await supabase.from("profiles").select("business_name").maybeSingle()).data });

  return (
    <div className="space-y-6">
      <div>
        <h1 className="text-2xl font-semibold tracking-tight">Lembretes</h1>
        <p className="text-sm text-muted-foreground">Organize os modelos da régua. Cada cobrança é revisada e enviada manualmente pelo WhatsApp.</p>
      </div>
      <Button asChild className="h-11 rounded-xl"><Link to="/contas"><MessageCircle className="mr-2 h-4 w-4" />Escolher conta e enviar via WhatsApp</Link></Button>

      {!ent.limits?.edit_rule_days && (
        <p className="flex items-center gap-2 rounded-xl bg-muted p-3 text-sm text-muted-foreground"><Lock className="h-4 w-4" />No plano Starter a régua é fixa. <Link to="/planos" className="font-medium text-primary underline">Faça upgrade</Link> para editar dias e etapas.</p>
      )}

      {rules.isLoading ? <div className="space-y-3">{[0, 1, 2, 3].map((i) => <Skeleton key={i} className="h-24 rounded-2xl" />)}</div>
        : rules.isError ? <ErrorBox onRetry={() => rules.refetch()} />
        : !rules.data?.length ? <p className="rounded-2xl border bg-card p-8 text-center text-sm text-muted-foreground">Nenhuma etapa encontrada. Recarregue a página para restaurar a régua padrão.</p>
        : (
          <ul className="space-y-3">
            {rules.data.map((r) => (
              <RuleCard key={r.id} rule={r} canDays={!!ent.limits?.edit_rule_days && ent.canWrite} canTexts={!!ent.limits?.edit_rule_texts && ent.canWrite} empresa={profile.data?.business_name ?? "Seu negócio"} />
            ))}
          </ul>
        )}

    </div>
  );
}

function ErrorBox({ onRetry }: { onRetry: () => void }) {
  return <div className="mt-3 flex items-center gap-3 text-sm text-danger"><AlertTriangle className="h-4 w-4" />Erro ao carregar.<Button size="sm" variant="outline" className="h-10" onClick={onRetry}><RotateCcw className="mr-1 h-4 w-4" />Tentar de novo</Button></div>;
}

function RuleCard({ rule, canDays, canTexts, empresa }: { rule: Rule; canDays: boolean; canTexts: boolean; empresa: string }) {
  const qc = useQueryClient();
  const [offset, setOffset] = useState(rule.offset_days);
  const [body, setBody] = useState(rule.body_tpl);
  const [open, setOpen] = useState(false);
  const bodyRef = useRef<HTMLTextAreaElement>(null);
  useEffect(() => { setOffset(rule.offset_days); setBody(rule.body_tpl); }, [rule]);

  const save = useMutation({
    mutationFn: async (patch: Partial<Rule>) => {
      const { error } = await supabase.from("reminder_rules").update(patch).eq("id", rule.id);
      if (error) throw error;
    },
    onSuccess: () => { qc.invalidateQueries({ queryKey: ["rules"] }); qc.invalidateQueries({ queryKey: ["activation"] }); toast.success("Régua atualizada."); },
    onError: (e) => toast.error(parseDbError(e).message),
  });
  const insertVar = (v: string) => {
    const el = bodyRef.current;
    const tag = `{{${v}}}`;
    if (!el) return setBody((b) => b + tag);
    const s = el.selectionStart, e = el.selectionEnd;
    setBody(body.slice(0, s) + tag + body.slice(e));
    requestAnimationFrame(() => { el.focus(); el.setSelectionRange(s + tag.length, s + tag.length); });
  };

  return (
    <li className="premium-surface rounded-2xl p-6 md:p-7">
      <div className="flex items-start justify-between gap-3">
        <div>
          <p className="font-semibold">{rule.label}</p>
          <p className="text-sm text-muted-foreground">{offsetLabel(rule.offset_days)}</p>
        </div>
        <div className="flex items-center gap-2">
          <Label htmlFor={`act-${rule.id}`} className="text-sm">{rule.active ? "Ativa" : "Inativa"}</Label>
          <Switch id={`act-${rule.id}`} checked={rule.active} disabled={!canDays || save.isPending} onCheckedChange={(v) => save.mutate({ active: v })} />
        </div>
      </div>
      <div className="mt-3 flex flex-wrap gap-2">
        <ReminderPreview modal company={empresa} body={body} />
        <Button size="sm" variant="ghost" className="h-10" onClick={() => setOpen(!open)}>{open ? "Fechar" : canDays ? "Editar" : "Ver lembrete"}</Button>
      </div>
      {open && (
        <div className="mt-4 grid gap-4 border-t pt-4 lg:grid-cols-2">
          <form className="space-y-3" onSubmit={(e) => { e.preventDefault(); save.mutate({ offset_days: offset, ...(canTexts ? { body_tpl: body.slice(0, 3000) } : {}) }); }}>
            <div>
              <Label htmlFor={`off-${rule.id}`}>Dias em relação ao vencimento (negativo = antes)</Label>
              <Input id={`off-${rule.id}`} type="number" min={-30} max={60} disabled={!canDays} value={offset} onChange={(e) => setOffset(Math.max(-30, Math.min(60, Number(e.target.value) || 0)))} className="mt-1.5 h-11 w-32 rounded-xl" />
            </div>
            <div>
              <Label htmlFor={`body-${rule.id}`}>Mensagem</Label>
              <Textarea id={`body-${rule.id}`} ref={bodyRef} disabled={!canTexts} value={body} maxLength={3000} rows={6} onChange={(e) => setBody(e.target.value)} className="mt-1.5 rounded-xl" />
              {canTexts ? (
                <div className="mt-2 flex flex-wrap gap-1.5">{VARS.map((v) => <button key={v} type="button" onClick={() => insertVar(v)} className="h-8 rounded-full border px-2.5 text-xs hover:bg-accent">{`{{${v}}}`}</button>)}</div>
              ) : <p className="mt-1 flex items-center gap-1 text-xs text-muted-foreground"><Lock className="h-3 w-3" />Editar textos está disponível no plano Business.</p>}
            </div>
            {canDays && <Button type="submit" className="h-11 rounded-xl" disabled={save.isPending}>Salvar etapa</Button>}
          </form>
          <div className="rounded-xl border bg-background p-4 text-sm" aria-label="Prévia da mensagem para WhatsApp">
            <p className="flex items-center gap-1.5 text-xs text-muted-foreground"><MessageCircle className="h-3.5 w-3.5" />Prévia do WhatsApp</p>
            <p className="mt-3 whitespace-pre-wrap leading-relaxed">{preview(body, empresa)}</p>
          </div>
        </div>
      )}
    </li>
  );
}
</file>

