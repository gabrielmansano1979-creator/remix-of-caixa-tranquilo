<file path="src/routes/api/public/asaas-webhook.ts">
import { createFileRoute } from "@tanstack/react-router";

type AsaasEvent = {
  id?: string;
  event?: string;
  type?: string;
  payment?: string;
  paymentId?: string;
  status?: string;
  data?: {
    id?: string;
    payment?: string;
    paymentId?: string;
    status?: string;
    object?: {
      id?: string;
      payment?: string;
      paymentId?: string;
      status?: string;
    };
  };
};

const normalizeStatus = (value: unknown) => String(value ?? "").toUpperCase();
const isPaidStatus = (status: string | undefined) => ["CONFIRMED", "RECEIVED", "PAID", "AUTHORIZED", "APPROVED", "SETTLED", "SUCCESS"].includes(normalizeStatus(status));
const firstDefined = (...values: Array<unknown>) => values.find((value) => value !== undefined && value !== null && String(value).trim() !== "") ?? null;

export const Route = createFileRoute("/api/public/asaas-webhook")({
  server: {
    handlers: {
      POST: async ({ request }) => {
        const body = await request.text();
        let event: AsaasEvent;
        try {
          event = JSON.parse(body);
        } catch {
          return new Response("invalid json", { status: 400 });
        }

        const { supabaseAdmin: db } = await import("@/integrations/supabase/client.server");

        try {
          if (event.id) {
            const { error: eventError } = await db.from("asaas_events").insert({ id: event.id, type: event.event ?? event.type ?? "unknown" });
            if (eventError?.code === "23505") return Response.json({ received: true, duplicate: true });
            if (eventError) throw eventError;
          }

        const paymentId = firstDefined(
          event.payment,
          event.paymentId,
          event.data?.payment,
          event.data?.paymentId,
          event.data?.object?.payment,
          event.data?.object?.paymentId,
          event.data?.object?.id,
          event.data?.id,
        );
        const paymentIdText = paymentId === null ? null : String(paymentId);
        const status = normalizeStatus(firstDefined(
          event.status,
          event.data?.status,
          event.data?.object?.status,
          event.type,
          event.event,
        ));

        if (paymentIdText && isPaidStatus(status)) {
          const { data: sub } = await db
            .from("subscriptions")
            .select("user_id, plan, affiliate_partner_id, affiliate_commission_percent, affiliate_payment_amount_cents")
            .eq("asaas_payment_id", paymentIdText)
            .maybeSingle();

          if (sub?.user_id) {
            const { error: updateError } = await db.from("subscriptions").update({
              status: "active",
              paid_at: new Date().toISOString(),
              updated_at: new Date().toISOString()
            }).eq("asaas_payment_id", paymentIdText);
            if (updateError) throw updateError;

            if (sub.affiliate_partner_id && sub.affiliate_commission_percent && sub.affiliate_payment_amount_cents) {
              const { data: profile } = await db.from("profiles").select("business_name").eq("user_id", sub.user_id).maybeSingle();
              const { error: commissionError } = await db.from("commissions").upsert({
                partner_id: sub.affiliate_partner_id,
                subscription_id: sub.user_id,
                payment_id: paymentIdText,
                client_name: profile?.business_name ?? "Cliente",
                amount_cents: Math.floor(sub.affiliate_payment_amount_cents * sub.affiliate_commission_percent / 100),
                status: "pending",
              }, { onConflict: "payment_id", ignoreDuplicates: true });
              if (commissionError) throw commissionError;
            }

            const { error: auditError } = await db.from("audit_logs").insert({
              user_id: sub.user_id,
              action: "subscription_start",
              meta: { plan: sub.plan, gateway: "asaas_pix" }
            });
            if (auditError) throw auditError;
          }
        }

          return Response.json({ received: true });
        } catch (error) {
          console.error("Asaas webhook processing failed", event.id, error);
          if (event.id) {
            const { error: cleanupError } = await db.from("asaas_events").delete().eq("id", event.id);
            if (cleanupError) console.error("Asaas webhook idempotency cleanup failed", event.id, cleanupError);
          }
          return new Response("webhook processing failed", { status: 500 });
        }
      },
    },
  },
});
</file>

<file path="src/routes/cadastro.tsx">
import { createFileRoute, Link, useNavigate } from "@tanstack/react-router";
import { useForm } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
import { z } from "zod";
import { useState } from "react";
import { MailCheck } from "lucide-react";
import { supabase } from "@/integrations/supabase/client";
import {
  AuthShell,
  GoogleButton,
  Divider,
  FieldError,
  PasswordStrength,
  passwordScore,
  translateAuthError,
} from "@/components/auth-shell";
import { toE164 } from "@/lib/phone";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Button } from "@/components/ui/button";

export const Route = createFileRoute("/cadastro")({
  validateSearch: z.object({ ref: z.string().trim().max(80).optional() }),
  head: () => ({
    meta: [
      { title: "Criar conta | Critical Cash" },
      { name: "description", content: "Teste o Critical Cash por 7 dias sem cartão de crédito." },
      { property: "og:title", content: "Criar conta — Critical Cash" },
      { property: "og:description", content: "Comece seu teste de 7 dias sem cartão." },
      { property: "og:type", content: "website" },
      { name: "twitter:card", content: "summary" },
    ],
  }),
  component: SignupPage,
});

const schema = z
  .object({
    full_name: z.string().trim().min(2, "Informe seu nome.").max(120),
    business_name: z.string().trim().min(2, "Informe o nome do negócio.").max(120),
    whatsapp: z
      .string()
      .max(25)
      .refine((v) => !!toE164(v), "Informe um WhatsApp com DDD."),
    email: z.string().trim().email("Informe um e-mail válido.").max(255),
    password: z.string().min(8, "A senha precisa ter ao menos 8 caracteres.").max(72),
    confirm: z.string(),
  })
  .refine((d) => passwordScore(d.password) >= 2, {
    message: "Use letras maiúsculas, minúsculas e números.",
    path: ["password"],
  })
  .refine((d) => d.password === d.confirm, {
    message: "As senhas não conferem.",
    path: ["confirm"],
  });

function SignupPage() {
  const { ref } = Route.useSearch();
  const navigate = useNavigate();
  const [sentTo, setSentTo] = useState<string | null>(null);
  const [error, setError] = useState<string | null>(null);
  const { register, handleSubmit, formState, watch } = useForm<z.infer<typeof schema>>({
    resolver: zodResolver(schema),
  });
  const pw = watch("password") ?? "";

  const onSubmit = handleSubmit(async (v) => {
    setError(null);
    try {
      const { data, error } = await supabase.auth.signUp({
        email: v.email,
        password: v.password,
        options: {
          emailRedirectTo: `${window.location.origin}/login`,
          data: {
            full_name: v.full_name,
            business_name: v.business_name,
            notification_whatsapp: toE164(v.whatsapp),
            ...(ref ? { affiliate_referral_code: ref.toUpperCase() } : {}),
          },
        },
      });
      if (error) return setError(translateAuthError(error.message));
      if (data.session) {
        const { error: setupError } = await supabase.rpc("ensure_user_setup");
        if (setupError) {
          console.error("Falha ao preparar a conta recém-criada:", setupError);
          return setError(
            "Sua conta foi criada, mas não foi possível concluir a configuração inicial. Entre novamente em instantes.",
          );
        }
        await navigate({ to: "/onboarding" });
        return;
      }
      setSentTo(v.email);
    } catch (error) {
      console.error("Falha ao criar conta:", error);
      setError(
        translateAuthError(
          error instanceof Error
            ? error.message
            : "Não foi possível conectar ao serviço de autenticação.",
        ),
      );
    }
  });

  if (sentTo) {
    return (
      <AuthShell title="Confirme seu e-mail">
        <div className="flex flex-col items-center text-center">
          <span className="grid h-14 w-14 place-items-center rounded-full bg-accent text-accent-foreground">
            <MailCheck className="h-7 w-7" />
          </span>
          <p className="mt-4 text-sm text-muted-foreground">
            Enviamos um link para <strong className="text-foreground">{sentTo}</strong>. Clique nele
            para ativar sua conta e começar seu teste grátis.
          </p>
          <Link to="/login" className="mt-6 text-sm font-medium text-primary hover:underline">
            Ir para o login
          </Link>
        </div>
      </AuthShell>
    );
  }

  return (
    <AuthShell
      title="Comece seus 7 dias grátis"
      subtitle="Passo 1 de 3 · Sem cartão de crédito."
      footer={
        <>
          Já tem conta?{" "}
          <Link to="/login" className="font-medium text-primary hover:underline">
            Entrar
          </Link>
        </>
      }
    >
      <GoogleButton label="Cadastrar com Google" />
      <Divider />
      <form onSubmit={onSubmit} noValidate className="space-y-4">
        {(
          [
            ["full_name", "Seu nome"],
            ["business_name", "Nome do negócio"],
            ["whatsapp", "WhatsApp para notificações"],
          ] as const
        ).map(([key, label]) => (
          <div key={key}>
            <Label htmlFor={key}>{label}</Label>
            <Input
              id={key}
              type={key === "whatsapp" ? "tel" : "text"}
              maxLength={key === "whatsapp" ? 25 : 120}
              className="mt-1.5 h-11"
              {...register(key)}
            />
            <FieldError msg={formState.errors[key]?.message} />
          </div>
        ))}
        <div>
          <Label htmlFor="email">E-mail</Label>
          <Input
            id="email"
            type="email"
            autoComplete="email"
            className="mt-1.5 h-11 rounded-xl"
            {...register("email")}
          />
          <FieldError msg={formState.errors.email?.message} />
        </div>
        <div>
          <Label htmlFor="password">Senha</Label>
          <Input
            id="password"
            type="password"
            autoComplete="new-password"
            className="mt-1.5 h-11 rounded-xl"
            {...register("password")}
          />
          <PasswordStrength value={pw} />
          <FieldError msg={formState.errors.password?.message} />
        </div>
        <div>
          <Label htmlFor="confirm">Confirmar senha</Label>
          <Input
            id="confirm"
            type="password"
            autoComplete="new-password"
            className="mt-1.5 h-11 rounded-xl"
            {...register("confirm")}
          />
          <FieldError msg={formState.errors.confirm?.message} />
        </div>
        {error && (
          <p className="rounded-xl bg-danger/10 p-3 text-sm text-danger" role="alert">
            {error}
          </p>
        )}
        <Button type="submit" className="h-11 w-full rounded-xl" disabled={formState.isSubmitting}>
          {formState.isSubmitting ? "Criando conta…" : "Testar Grátis por 7 Dias"}
        </Button>
        <p className="text-center text-xs text-muted-foreground">
          Ao criar a conta você aceita os{" "}
          <Link to="/termos" className="underline">
            Termos
          </Link>{" "}
          e a{" "}
          <Link to="/privacidade" className="underline">
            Política de Privacidade
          </Link>
          .
        </p>
      </form>
    </AuthShell>
  );
}
</file>

